  "guardrail_anti_patterns": {
    "_description": "Patterns that indicate the LLM is about to make a mistake. PreToolUse hook checks Edit/Write commands against these.",

    "designing_own_test": {
      "pattern": "(let me|I'll|I will) (write|design|create|build) (a|my own|some) (test|verification|check)",
      "severity": "HIGH",
      "action": "STOP: Check if project has existing tests/validate scripts first. Run validate_all.py --quick.",
      "memory_ref": "diagnose-before-modify"
    },

    "judging_by_number": {
      "pattern": "(this (number|value|result|output) (seems|looks|is) (wrong|off|incorrect|strange|weird|abnormal))|(that can't be right)|(should be (lower|higher|different|closer))",
      "severity": "CRITICAL",
      "action": "STOP: Check memory for known baselines before judging. 'Wrong' numbers are often known baselines. grep MEMORY.md first.",
      "memory_ref": "diagnose-before-modify"
    },

    "modify_without_context": {
      "pattern": "(let me|I'll|I will) (just )?(quickly )?(fix|modify|change|edit|update|patch) (this|the|that)",
      "severity": "HIGH",
      "action": "STOP: Run validate_all.py --quick for this module first. grep MEMORY.md for relevant memories.",
      "memory_ref": "validate-driven-guardrail"
    },

    "exploring_without_search": {
      "pattern": "(let me|I'll|I will) (try|explore|see if|check if|investigate|figure out)",
      "severity": "MEDIUM",
      "action": "WARNING: Have you checked memory and run ws first? Don't explore blind.",
      "memory_ref": "use-ws-instead-of-websearch"
    },

    "assuming_api_behavior": {
      "pattern": "(I think|probably|should be|I believe|the API|the function|the method) (should|would|must|probably|likely)",
      "severity": "HIGH",
      "action": "STOP: You're guessing API behavior. Run ws to verify, or check code directly.",
      "memory_ref": "signature-body-drift"
    },

    "trusting_comment_over_code": {
      "pattern": "(the comment says|the doc says|the README says|according to the doc)",
      "severity": "MEDIUM",
      "action": "WARNING: Comments/docs can be outdated. Verify against actual code/behavior.",
      "memory_ref": "verify-merge-order"
    },

    "design_test_from_scratch": {
      "pattern": "(I'll|I will|let me) (check|verify|test|confirm) (by|with|using) (a quick|a simple|a small|my own)",
      "severity": "CRITICAL",
      "action": "STOP: Never design your own test. Run existing tests. Use validate scripts.",
      "memory_ref": "diagnose-before-modify"
    },

    "background_ws": {
      "pattern": "run_in_background.*true.*ws|ws.*run_in_background",
      "severity": "HIGH",
      "action": "STOP: Never run ws in background. Use --quick for fast search.",
      "memory_ref": "use-ws-instead-of-websearch"
    },

    "hardcode_data": {
      "pattern": "(I'll|I will|let me) (make up|invent|fabricate|hardcode|fake|mock up) (some |the )?(data|numbers|values|results)",
      "severity": "CRITICAL",
      "action": "STOP: All data must come from real measurements/code output. Never fabricate.",
      "memory_ref": "data-driven-tex-figures"
    },

    "ai_review_as_truth": {
      "pattern": "(the AI|doubao|the bot|the reviewer|the review) (says|said|reported|found|detected|identified)",
      "severity": "MEDIUM",
      "action": "WARNING: AI review = ADVISORY ONLY. Verify with programmatic checks first.",
      "memory_ref": "ai-review-layered-trust"
    }
  }
