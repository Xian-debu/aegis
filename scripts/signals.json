  "health_checks": {
    "disk": {"command": "df -h / | awk 'NR==2{print $5, $3\"/\"$2}'", "warn_threshold": "80%"},
    "memory": {"command": "free -h | awk 'NR==2{print $3\"/\"$2, $4\" free\"}'"},
    "gpu": {"command": "/usr/lib/wsl/lib/nvidia-smi --query-gpu=memory.used,memory.total,utilization.gpu --format=csv,noheader"},
    "docker": {"command": "docker ps -a --format '{{.Names}}:{{.Status}}' | paste -sd ';'"},
    "ollama": {"command": "ollama list 2>/dev/null | tail -n +2 | wc -l"},
    "swap": {"command": "free -h | awk 'NR==3{print $3\"/\"$2}'"}
  },

